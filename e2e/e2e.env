# Settings for the end-to-end test stack (copied to .env by CI). No real API keys:
# generation goes to the stub LLM, embeddings run locally.
APP_ENV=development
JWT_SECRET=e2e-only-not-a-real-secret-0123456789abcdef

DEFAULT_LLM_MODEL=stub:stub-model
DEFAULT_FAST_MODEL=stub:stub-model
LLM_ENDPOINTS={"stub": {"base_url": "http://stub-llm:8080/v1", "api_key": "unused"}}

DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEFAULT_EMBEDDING_DIMENSIONS=384

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentrag
