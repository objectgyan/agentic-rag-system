# ============================================================
# AgentRAG Environment Configuration
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://agentrag:agentrag@localhost:5432/agentrag
DATABASE_SYNC_URL=postgresql://agentrag:agentrag@localhost:5432/agentrag

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO/S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentrag
MINIO_USE_SSL=false

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3000/auth/callback

# --- LLM Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# --- Model Defaults ---
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EMBEDDING_DIMENSIONS=1536
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_RERANKER_MODEL=rerank-english-v3.0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- App ---
APP_NAME=AgentRAG
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE_MB=100
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
